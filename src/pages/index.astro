---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Cabecalho from "@/components/Cabecalho.astro";
import CartaoArtigo from "@/components/CartaoArtigo.astro";
import { t } from "@/lib/i18n";

const artigos = (await getCollection("products", ({ data }) => !data.rascunho)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);
---

<BaseLayout>
  <Cabecalho />

  <section class="envolvente intro">
    <h1>Vestidos e conjuntos para todos os dias</h1>
    <p>
      Confira o nosso catálogo. Escolha a peça, diga-nos a cor e o tamanho, e falamos consigo pelo
      WhatsApp.
    </p>
  </section>

  <section class="envolvente listagem" aria-label={t.artigos}>
    {
      artigos.length === 0 ? (
        <p class="vazio">{t.semArtigos}</p>
      ) : (
        <div class="grelha">
          {artigos.map((artigo) => (
            <CartaoArtigo artigo={artigo} />
          ))}
        </div>
      )
    }
  </section>

  <footer class="envolvente rodape">
    <p>© {new Date().getFullYear()} SuaCara Modas</p>
  </footer>
</BaseLayout>

<style>
  .intro {
    padding-block: var(--esp-12) var(--esp-8);
    max-width: 42rem;
  }

  .intro h1 {
    font-size: clamp(1.875rem, 5vw, 3rem);
  }

  .intro p {
    margin: 0;
    color: var(--cor-texto-suave);
    font-size: 1.0625rem;
  }

  .listagem {
    padding-bottom: var(--esp-16);
  }

  .grelha {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--esp-6) var(--esp-4);
  }

  @media (min-width: 48rem) {
    .grelha {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--esp-8) var(--esp-6);
    }
  }

  .vazio {
    color: var(--cor-texto-suave);
  }

  .rodape {
    padding-block: var(--esp-8);
    border-top: 1px solid var(--cor-linha);
    color: var(--cor-texto-suave);
    font-size: 0.875rem;
  }
</style>
